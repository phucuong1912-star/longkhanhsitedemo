# WordPress backup
wp-content/duplicator-backups/
wp-content/updraft/
wp-content/ai1wm-backups/

# WordPress cache
wp-content/cache/
.htaccess
wp-config.php
# Environment
.env
.env.*
*.log
# Dependencies
node_modules/
# Only project-root development dependencies; bundled WordPress/plugin vendor
# directories are required on the host.
/vendor/
wp-content/uploads/elementor/css/
feedback-2.rtf
feedback_final.rtf
new-day.rtf

# Local maintenance scripts and generated reports
/.codex-tools/

# Deployment readiness/status are generated per environment, never committed.
/.layout-ready/
/wp-content/lk-layouts/ready.json
/wp-content/lk-layouts/applied.json
/wp-content/lk-layouts/*.tmp*

# Local verification bytecode is never a deployment artifact.
__pycache__/
*.pyc
VPS-Note.MD
VPS-Note.md

# LiteSpeed runtime data and environment-specific configuration are not source.
/wp-content/litespeed/
/wp-content/.litespeed_conf.php
/wp-content/.litespeed_conf.dat
/wp-content/object-cache.php
/wp-content/advanced-cache.php
/.htaccess.bk
